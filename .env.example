# NAWI Platform Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nawi_db?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Optional Cloudinary Credentials (For storing photo evidence in cloud)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
